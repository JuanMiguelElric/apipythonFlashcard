# Neo4j
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_LIFETIME=3600
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=30

# Autenticacao servico-a-servico (deve ser identico ao Laravel: config/services.php -> flashcard_service.token / .env FLASHCARD_SERVICE_TOKEN)
SERVICE_TOKEN=

# Paginacao
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200

# App
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
LOG_LEVEL=INFO
